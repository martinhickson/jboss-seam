                    <exclude>**/org/jboss/seam/framework/HibernateEntityController.java</exclude>
                    <exclude>**/org/jboss/seam/framework/HibernateEntityHome.java</exclude>
                    <exclude>**/org/jboss/seam/framework/HibernateEntityQuery.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/DelegatingFacesContext.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/SeamApplication.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/SeamStateManagementStrategy.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/SeamStateManager.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/UnifiedELMethodBinding.java</exclude>
                    <exclude>**/org/jboss/seam/jsf/UnifiedELValueBinding.java</exclude>
                    <exclude>**/org/jboss/seam/mock/AbstractSeamTest.java</exclude>
                    <exclude>**/org/jboss/seam/mock/MockApplication.java</exclude>
                    <exclude>**/org/jboss/seam/mock/MockExternalContext.java</exclude>
                    <exclude>**/org/jboss/seam/mock/MockFacesContext.java</exclude>
                    <exclude>**/org/jboss/seam/mock/MockHttpServletRequest.java</exclude>
                    <exclude>**/org/jboss/seam/mock/MockStateManager.java</exclude>
                    <exclude>**/org/jboss/seam/navigation/Param.java</exclude>
                    <exclude>**/org/jboss/seam/deployment/URLScanner.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/FullTextEntityManagerProxy.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/FullTextHibernateSessionProxy.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/HibernatePersistenceProvider.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/HibernateSessionFactory.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/HibernateSessionInvocationHandler.java</exclude>
                    <exclude>**/org/jboss/seam/persistence/ManagedHibernateSession.java</exclude>
