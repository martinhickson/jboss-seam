              </resources>
              <overwrite>false</overwrite>
            </configuration>
          </execution>
          <execution>
            <id>copy-antlr-files</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/jakarta-antlr</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.basedir}/jboss-seam/src/main/antlr</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
              <overwrite>true</overwrite>
            </configuration>
          </execution>
          <execution>
            <id>copy-resource-files</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <outputDirectory>${project.basedir}/target/generated/resources</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.basedir}/jboss-seam/src/main/resources</directory>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>META-INF/faces-config.xml</exclude>
                  </excludes>
                </resource>
              </resources>
              <overwrite>true</overwrite>
            </configuration>
          </execution>
          <execution>
            <id>copy-jakarta-faces-config</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <outputDirectory>${project.basedir}/target/generated/resources</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/jakarta-resources</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
              <overwrite>true</overwrite>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- ANTLR Maven Plugin for generating parser from grammar -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>antlr-maven-plugin</artifactId>
        <version>2.2</version>
        <configuration>
          <sourceDirectory>${project.basedir}/src/main/jakarta-antlr</sourceDirectory>
          <grammars>org/jboss/seam/text/seam-text.g</grammars>
        </configuration>
        <executions>
          <execution>
            <id>antlr-generation</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-sources</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.google.code.maven-replacer-plugin</groupId>
        <artifactId>replacer</artifactId>
        <executions>
          <execution>
            <id>jakarta-migration-sources</id>
            <goals>
              <goal>replace</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <basedir>${project.basedir}/src/generated/jakarta</basedir>
            </configuration>
          </execution>
          <execution>
            <id>jakarta-migration-resources</id>
            <goals>
              <goal>replace</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <basedir>${project.basedir}/target/generated/resources</basedir>
            </configuration>
          </execution>
          <execution>
            <id>replace-exception-handler-factory</id>
            <goals>
              <goal>replace</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <basedir>${project.basedir}/target/generated/resources</basedir>
              <includes>
                <include>**/*.xml</include>
              </includes>
              <regex>true</regex>
              <replacements>
                <replacement>
                  <token>\s*&lt;exception-handler-factory&gt;(?:jakarta\.faces\.webapp\.PreJsf2ExceptionHandlerFactory|com\.sun\.faces\.context\.ExceptionHandlerFactoryImpl)&lt;/exception-handler-factory&gt;\s*</token>
                  <value>&lt;exception-handler-factory&gt;org.jboss.seam.jsf.SeamExceptionHandlerFactory&lt;/exception-handler-factory&gt;</value>
                </replacement>
              </replacements>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>add-jakarta-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <!-- src/generated/jakarta after javax → jakarta replacer -->
                <source>${project.basedir}/src/generated/jakarta</source>
                <source>${project.basedir}/target/generated-sources/antlr</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <sourceDirectory>src/main/java</sourceDirectory>
  </build>
</project>
