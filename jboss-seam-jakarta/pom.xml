<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.jboss.seam</groupId>
        <artifactId>seam-parent</artifactId>
        <version>2.3.1.jakarta.bravura.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <artifactId>jboss-seam-jakarta</artifactId>
    <packaging>jar</packaging>
    
    <name>JBoss Seam - Jakarta EE Version</name>
    <description>Jakarta EE version of jboss-seam</description>
    
    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.0.0</version> <!-- use latest stable version -->
                <executions>
                  <execution>
                    <id>enforce-java</id>
                    <goals>
                      <goal>enforce</goal>
                    </goals>
                    <configuration>
                      <rules>
                        <requireJavaVersion>
                          <version>[17,18)</version> <!-- allows Java 17 but less than 18 -->
                          <message>You must use JDK 17 to build this project.</message>
                        </requireJavaVersion>
                      </rules>
                      <fail>true</fail>
                    </configuration>
                  </execution>
                </executions>
            </plugin>                       
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-source-files</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/generated/jakarta</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../jboss-seam/src/main/java</directory>
                                    <filtering>false</filtering>
                                     <excludes>
                                     	<exclude>**/org/jboss/seam/Model.java</exclude>
	                                    <exclude>**/org/jboss/seam/bpm/ProcessInstanceFinder.java</exclude>
	                                    <exclude>**/org/jboss/seam/bpm/TaskInstancePriorityList.java</exclude>
	                                    <exclude>**/org/jboss/seam/cache/JbossCacheProvider.java</exclude>
	                                    <exclude>**/org/jboss/seam/cache/JbossPojoCacheProvider.java</exclude>
	                                    <exclude>**/org/jboss/seam/core/Validators.java</exclude>
	                                    <exclude>**/org/jboss/seam/framework/HibernateEntityController.java</exclude>
	                                    <exclude>**/org/jboss/seam/framework/HibernateEntityHome.java</exclude>
	                                    <exclude>**/org/jboss/seam/framework/HibernateEntityQuery.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/DelegatingFacesContext.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/SeamApplication.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/SeamStateManagementStrategy.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/SeamStateManager.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/UnifiedELMethodBinding.java</exclude>
	                                    <exclude>**/org/jboss/seam/jsf/UnifiedELValueBinding.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/AbstractSeamTest.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/MockApplication.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/MockExternalContext.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/MockFacesContext.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/MockHttpServletRequest.java</exclude>
	                                    <exclude>**/org/jboss/seam/mock/MockStateManager.java</exclude>
	                                    <exclude>**/org/jboss/seam/navigation/Param.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/FullTextEntityManagerProxy.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/FullTextHibernateSessionProxy.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/HibernatePersistenceProvider.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/HibernateSessionFactory.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/HibernateSessionInvocationHandler.java</exclude>
	                                    <exclude>**/org/jboss/seam/persistence/ManagedHibernateSession.java</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                            <overwrite>false</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-antlr-files</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/main/jakarta-antlr</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../jboss-seam/src/main/antlr</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-resource-files</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/target/generated/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../jboss-seam/src/main/resources</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- ANTLR Maven Plugin for generating parser from grammar -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>antlr-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/src/main/jakarta-antlr</sourceDirectory>
                    <grammars>org/jboss/seam/text/seam-text.g</grammars>
                </configuration>
                <executions>
                    <execution>
                        <id>antlr-generation</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
    <groupId>io.github.floverfelt</groupId>
    <artifactId>find-and-replace-maven-plugin</artifactId>
    <version>1.2.0</version>
    <executions>
        <execution>
            <id>replace</id>
            <phase>generate-sources</phase>
            <goals>
                <goal>find-and-replace</goal>
            </goals>
            <configuration>
                <replacementType>file-contents</replacementType>
                <baseDir>src/generated/jakarta</baseDir>
                <findRegex>javax.interceptor</findRegex>
                <replaceValue>jakarta.interceptor</replaceValue>
                <recursive>true</recursive>
            </configuration>
        </execution>
        <execution>
            <id>replace2</id>
            <phase>generate-sources</phase>
            <goals>
                <goal>find-and-replace</goal>
            </goals>
            <configuration>
                <replacementType>file-contents</replacementType>
                <baseDir>src/generated/jakarta</baseDir>javax.transaction
                <findRegex>javax.faces</findRegex>
                <replaceValue>jakarta.faces</replaceValue>
                <recursive>true</recursive>
            </configuration>
        </execution>
        <execution>
            <id>replace3</id>
            <phase>generate-sources</phase>
            <goals>
                <goal>find-and-replace</goal>
            </goals>
            <configuration>
                <replacementType>file-contents</replacementType>
                <baseDir>src/generated/jakarta</baseDir>
                <findRegex>javax.transaction</findRegex>
                <replaceValue>jakarta.transaction</replaceValue>
                <recursive>true</recursive>
            </configuration>
        </execution>
        <execution>
            <id>replace-persistence</id>
            <phase>generate-sources</phase>
            <goals>
               <goal>find-and-replace</goal>
            </goals>
            <configuration>
              <replacementType>file-contents</replacementType>
              <baseDir>src/generated/jakarta</baseDir>
              <findRegex>javax.persistence</findRegex>
               <replaceValue>jakarta.persistence</replaceValue>
               <recursive>true</recursive>
            </configuration>
        </execution>
        </executions>
            </plugin>
            <!-- OpenRewrite Maven Plugin for Jakarta EE 10 migration -->
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>6.13.0</version>
                <executions>
                    <execution>
                        <id>jakarta-migration</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>runNoFork</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <activeRecipes>
                        <recipe>org.openrewrite.java.migrate.jakarta.JakartaEE10</recipe>
                        <recipe>org.openrewrite.java.migrate.jakarta.JavaxMigrationToJakarta</recipe>
                        <recipe>org.openrewrite.java.migrate.jakarta.Faces2xMigrationToJakartaFaces3x</recipe>
                        <recipe>org.openrewrite.java.migrate.jakarta.JavaxInterceptorToJakartaInterceptor</recipe>
                        <recipe>org.openrewrite.java.migrate.jakarta.JavaxElToJakartaEl</recipe>
                    </activeRecipes>
                    <arguments>
                        <argument>- -errors</argument>
                    </arguments>
                    <inclusions>
						<inclusion>**/src/generated/jakarta/**/*.java</inclusion>
					</inclusions>
                    <exclusions>
						<exclusion>**/src/main/**/*.java</exclusion>
                        <exclusion>**/org/jboss/seam/Model.java</exclusion>
	                    <exclusion>**/org/jboss/seam/bpm/ProcessInstanceFinder.java</exclusion>
	                    <exclusion>**/org/jboss/seam/bpm/TaskInstancePriorityList.java</exclusion>
                        <exclusion>**/org/jboss/seam/cache/JbossCacheProvider.java</exclusion>
	                    <exclusion>**/org/jboss/seam/cache/JbossPojoCacheProvider.java</exclusion>
	                    <exclusion>**/org/jboss/seam/core/Validators.java</exclusion>
	                    <exclusion>**/org/jboss/seam/framework/HibernateEntityController.java</exclusion>
	                    <exclusion>**/org/jboss/seam/framework/HibernateEntityHome.java</exclusion>
	                    <exclusion>**/org/jboss/seam/framework/HibernateEntityQuery.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/DelegatingFacesContext.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/SeamApplication.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/SeamStateManagementStrategy.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/SeamStateManager.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/UnifiedELMethodBinding.java</exclusion>
	                    <exclusion>**/org/jboss/seam/jsf/UnifiedELValueBinding.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/AbstractSeamTest.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/MockApplication.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/MockExternalContext.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/MockFacesContext.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/MockHttpServletRequest.java</exclusion>
	                    <exclusion>**/org/jboss/seam/mock/MockStateManager.java</exclusion>
	                    <exclusion>**/org/jboss/seam/navigation/Param.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/FullTextEntityManagerProxy.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/FullTextHibernateSessionProxy.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/HibernatePersistenceProvider.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/HibernateSessionFactory.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/HibernateSessionInvocationHandler.java</exclusion>
	                    <exclusion>**/org/jboss/seam/persistence/ManagedHibernateSession.java</exclusion>
                    </exclusions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-migrate-java</artifactId>
                        <version>3.13.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>add-jakarta-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <!-- src/generated since OpenRewrite unconditionally skips target/generated -->
                                <source>${project.basedir}/src/generated/jakarta</source>
                                <source>${project.basedir}/target/generated-sources/antlr</source>
                                <source>${project.basedir}/target/generated/resources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself.-->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>
                                            org.openrewrite.maven
                                        </groupId>
                                        <artifactId>
                                            rewrite-maven-plugin
                                        </artifactId>
                                        <versionRange>
                                            [6.13.0,)
                                        </versionRange>
                                        <goals>
                                            <goal>runNoFork</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <execute></execute>
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                	<pluginExecutionFilter>
                                		<groupId>
                                			org.codehaus.mojo
                                		</groupId>
                                		<artifactId>
                                			antlr-maven-plugin
                                		</artifactId>
                                		<versionRange>
                                			[2.2,)
                                		</versionRange>
                                		<goals>
                                			<goal>generate</goal>
                                		</goals>
                                	</pluginExecutionFilter>
                                	<action>
                                		<ignore></ignore>
                                	</action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    
