                </executions>
            </plugin> -->

      <!-- Java 17 Compiler Configuration -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>

      <!-- Maven Enforcer Plugin - Enforce JDK 17 minimum -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>❌ JDK 17 or higher is required for Jakarta EE 10 compatibility.
                                        Current JDK: ${java.version}
                                        
                                        Jakarta EE 10 dependencies are compiled with JDK 17 bytecode (version 61.0).
                                        Please upgrade to JDK 17 or higher to build this module.
                                        
                                        See context/jdk17-migration-justification.md for detailed analysis.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.0,)</version>
                  <message>Maven 3.6.0 or higher is required</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Javadoc Plugin -->
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <skip>true</skip>
          <links>
            <link>http://docs.oracle.com/javase/17/docs/api/</link>
          </links>
          <keywords>true</keywords>
          <author>true</author>
          <stylesheetfile>jdstyle.css</stylesheetfile>
          <doctitle>JBoss Seam Jakarta ${project.name} API ${project.version}</doctitle>
          <detectOfflineLinks>false</detectOfflineLinks>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <sourceDirectory>src/main/java</sourceDirectory>
  </build>
</project>
