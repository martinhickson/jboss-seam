<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.martinhickson</groupId>
    <artifactId>seam-parent</artifactId>
    <version>2.3.1.jakarta.bravura.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>jboss-seam-ui-jakarta</artifactId>
  <packaging>jar</packaging>

  <name>Seam UI Jakarta - JSF2 support</name>
  <description>Jakarta EE version of Seam UI JSF2 support</description>

  <dependencies>
    <!-- Jakarta EE Dependencies -->
    <dependency>
      <groupId>jakarta.faces</groupId>
      <artifactId>jakarta.faces-api</artifactId>
      <version>4.1.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.el</groupId>
      <artifactId>jakarta.el-api</artifactId>
      <version>6.0.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- JBoss Seam Jakarta Core -->
    <dependency>
      <groupId>io.github.martinhickson</groupId>
      <artifactId>jboss-seam-jakarta</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>

    <!-- RichFaces Dependencies -->
    <dependency>
      <groupId>org.richfaces.core</groupId>
      <artifactId>richfaces-core-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.richfaces.core</groupId>
      <artifactId>richfaces-core-impl</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Third-party Dependencies -->
    <dependency>
      <groupId>org.javassist</groupId>
      <artifactId>javassist</artifactId>
      <version>3.28.0-GA</version>
    </dependency>
    <dependency>
      <groupId>org.dom4j</groupId>
      <artifactId>dom4j</artifactId>
      <version>2.1.3</version>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <version>3.0.2</version>
      <!-- or the latest version -->
    </dependency>
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <version>3.0.0</version>
      <!-- or latest version -->
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>jakarta.faces</artifactId>
      <version>3.0.2</version>
      <!-- or latest -->
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>antlr</groupId>
      <artifactId>antlr</artifactId>
      <version>2.7.7</version>
    </dependency>

    <dependency>
      <groupId>org.richfaces.cdk</groupId>
      <artifactId>annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Test Dependencies -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>5.14.10</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Eclipse m2e settings -->
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.google.code.maven-replacer-plugin</groupId>
                    <artifactId>replacer</artifactId>
                    <versionRange>[1.5.3,)</versionRange>
                    <goals>
                      <goal>replace</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore></ignore>
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.richfaces.cdk</groupId>
                    <artifactId>maven-cdk-plugin</artifactId>
                    <versionRange>[4.2.2-bravura-20,)</versionRange>
                    <goals>
                      <goal>generate</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore></ignore>
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.github.ekryd.sortpom</groupId>
        <artifactId>sortpom-maven-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <createBackupFile>true</createBackupFile>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>sort</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-source-files</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <outputDirectory>src/generated/jakarta</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.basedir}/jboss-seam-ui/src/main/java</directory>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>**/org/jboss/seam/ui/validator/ModelValidator.java</exclude>
                    <exclude>**/org/jboss/seam/ui/facelet/RendererRequest.java</exclude>
                    <exclude>**/org/jboss/seam/ui/util/cdk/MethodBindingToMethodExpression.java</exclude>
                    <exclude>**/org/jboss/seam/ui/util/cdk/MethodExpressionToMethodBinding.java</exclude>
                    <exclude>**/org/jboss/seam/ui/util/cdk/SimpleActionMethodBinding.java</exclude>
                    <!-- Exclude complex files that need manual override -->
                    <!--
                                        <exclude>**/org/jboss/seam/ui/component/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/facelet/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/renderkit/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/handler/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/converter/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/validator/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/graphicImage/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/resource/**</exclude>
                                        <exclude>**/org/jboss/seam/ui/util/**</exclude> -->
                  </excludes>
                </resource>
              </resources>
              <overwrite>false</overwrite>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Phase 2: javax → jakarta transformation -->
      <plugin>
        <groupId>com.google.code.maven-replacer-plugin</groupId>
        <artifactId>replacer</artifactId>
        <executions>
          <execution>
            <id>jakarta-migration-sources</id>
            <goals>
              <goal>replace</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <basedir>${project.basedir}/src/generated/jakarta</basedir>
            </configuration>
          </execution>
          <execution>
            <id>jakarta-migration-cdk-generated</id>
            <goals>
              <goal>replace</goal>
            </goals>
            <phase>process-sources</phase>
            <configuration>
              <basedir>${project.build.directory}/generated-sources/main</basedir>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Phase 3: Add generated sources to compilation -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>src/generated/jakarta</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-cdk-generated-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>process-sources</phase>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-cdk-generated-resources</id>
            <goals>
              <goal>add-resource</goal>
            </goals>
            <phase>process-sources</phase>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.build.directory}/generated-sources/main/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- RichFaces CDK Plugin for UI component generation -->
      <plugin>
        <groupId>org.richfaces.cdk</groupId>
        <artifactId>maven-cdk-plugin</artifactId>
        <version>${version.richfaces.cdk}</version>
        <configuration>
          <library>
            <prefix>org.jboss.seam.ui</prefix>
            <description>JSF controls for JBoss Seam Jakarta</description>
          </library>
          <jvmArgs>
            <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.io=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.security=ALL-UNNAMED</jvmArg>
          </jvmArgs>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-sources</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>io.github.martinhickson</groupId>
        <artifactId>seam-cdk-helper</artifactId>
        <version>1.0.1</version>
        <executions>
          <execution>
            <goals>
              <goal>execute</goal>
            </goals>
            <phase>generate-sources</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Java 17 Compiler Configuration -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>

      <!-- Maven Enforcer Plugin - Enforce JDK 17 minimum -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>❌ JDK 17 or higher is required for Jakarta EE 10 compatibility.
                                        Current JDK: ${java.version}
                                        
                                        Jakarta EE 10 dependencies are compiled with JDK 17 bytecode (version 61.0).
                                        Please upgrade to JDK 17 or higher to build this module.
                                        
                                        See context/jdk17-migration-justification.md for detailed analysis.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.0,)</version>
                  <message>Maven 3.6.0 or higher is required</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Javadoc Plugin (required for Maven Central jar publishing) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <doclint>none</doclint>
          <failOnError>false</failOnError>
          <quiet>true</quiet>
          <detectOfflineLinks>false</detectOfflineLinks>
          <doctitle>JBoss Seam Jakarta ${project.name} API ${project.version}</doctitle>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <sourceDirectory>src/main/java</sourceDirectory>
  </build>
</project>
